DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
ADMIN_EMAIL="crosstrainfc@gmail.com"
ADMIN_PASSWORD="change-this-password"
AUTH_SECRET="replace-with-a-long-random-secret"

# WhatsApp Cloud API. Keep these server-side only; do not prefix with NEXT_PUBLIC_.
META_TOKEN="replace-with-meta-access-token"
WHATSAPP_TEST_PHONE_NUMBER="+15551934690"
WHATSAPP_BUSINESS_PHONE_NUMBER_ID="1047227498473424"
WHATSAPP_BUSINESS_ACCOUNT_ID="1505830407738674"
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-webhook-verify-token"

# Optional: set this to use an approved Meta template instead of free-form text.
# The sample Meta test template is hello_world, but production reminders should use
# an approved renewal/reminder template.
WHATSAPP_REMINDER_TEMPLATE_NAME="jaspers_market_order_confirmation_v1"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_TEMPLATE_BODY_PARAM_FIELDS="memberName,memberId,expiry"

# Set STATIC_EXPORT=true only for static hosting such as GitHub Pages.
# WhatsApp reminder sending requires a server runtime and will not work in static export.
STATIC_EXPORT="false"
